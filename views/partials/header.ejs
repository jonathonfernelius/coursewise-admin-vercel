<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#146b43">
  <title><%= title %> | CourseWise Admin</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="CourseWise Admin home">
        <img src="/images/coursewise-logo-white.png" alt="CourseWise" class="brand-logo">
        <span class="brand-divider" aria-hidden="true"></span>
        <span class="brand-label">Admin</span>
      </a>
      <% if (loggedIn) { %>
        <nav class="header-nav" aria-label="Main navigation">
          <a href="/users">Maintain Users</a>
          <a href="/tasks">Maintain Tasks</a>
          <form action="/logout" method="post">
            <button class="nav-logout" type="submit">Log out</button>
          </form>
        </nav>
      <% } %>
    </div>
  </header>
  <main class="page-shell">
    <% if (notice) { %><div class="notice <%= noticeType === 'error' ? 'notice-error' : '' %>" role="<%= noticeType === 'error' ? 'alert' : 'status' %>"><%= notice %></div><% } %>
