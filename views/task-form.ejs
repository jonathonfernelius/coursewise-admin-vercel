<%- include("partials/header", { title: pageTitle, loggedIn, notice }) %>
<section class="page-heading compact-heading">
  <div><p class="eyebrow">ADMIN WORKSPACE / TASKS</p><h1><%= pageTitle %></h1><p class="lead-small">This task is saved to the existing CourseWise Tasks table.</p></div>
  <a class="text-link" href="/tasks">← Back to tasks</a>
</section>
<section class="form-panel">
  <% if (!users.length) { %>
    <div class="inline-notice">Add a CourseWise user before creating a task.</div>
    <a class="button button-primary" href="/users/new">Add user</a>
  <% } else { %>
    <form action="<%= formAction %>" method="post" class="record-form">
      <div class="form-grid">
        <div class="field full-field"><label for="name">Task name</label><input id="name" name="name" type="text" maxlength="300" value="<%= task ? task.Name : '' %>" required></div>
        <div class="field full-field"><label for="user_id">Assign to</label><select id="user_id" name="user_id" required><option value="">Choose a user</option><% users.forEach(user => { const displayName = [user.FirstName, user.LastName].filter(Boolean).join(' ') || user.Username || 'CourseWise user'; %><option value="<%= user.UserID %>" <%= task && String(task.UserID) === String(user.UserID) ? 'selected' : '' %>><%= displayName %></option><% }) %></select></div>
        <div class="field"><label for="due_date">Due date</label><input id="due_date" name="due_date" type="date" value="<%= task ? dateForInput(task.TaskDueDate) : '' %>"><span class="field-help">Leave blank if there is no due date.</span></div>
        <label class="check-field"><input name="is_complete" type="checkbox" <%= task && task.IsComplete ? 'checked' : '' %>><span class="check-box"></span><span><b>Mark as complete</b><small>Update the task status in CourseWise.</small></span></label>
      </div>
      <div class="form-actions"><a class="button button-outline" href="/tasks">Cancel</a><button class="button button-primary" type="submit"><%= task ? 'Save changes' : 'Create task' %></button></div>
    </form>
  <% } %>
</section>
<%- include("partials/footer") %>
